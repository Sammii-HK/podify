# Podcast Pipeline Configuration
# Copy to .env and fill in your keys

# LLM Provider (for script generation)
# Option A: Local Ollama (default - free, runs on Mac Mini)
OLLAMA_URL=http://100.74.111.30:11434
OLLAMA_PODCAST_MODEL=qwen3:14b

# Option B: DeepInfra (hosted, use a strong DeepSeek model)
DEEPINFRA_API_KEY=...
# Optional override if your account exposes a newer model
# DEEPINFRA_LLM_MODEL=deepseek-ai/DeepSeek-V3-0324

# Option B: OpenRouter (alternative)
OPENROUTER_API_KEY=sk-or-...

# Option B: inference.sh (if you prefer unified platform)
INFERENCE_API_KEY=inf_...

# TTS Provider
# Option A: local Voicebox/Kokoro (default - free, runs on Mac Mini)
VOICEBOX_BASE_URL=http://127.0.0.1:8880
# Optional profile rotation. Prefer profile IDs if known, otherwise names.
# VOICEBOX_PROFILE_IDS=...
# VOICEBOX_PROFILES=lunary-kokoro-heart,lunary-kokoro-sarah,lunary-kokoro-bella,lunary-kokoro-sky
# Paid TTS fallback is off by default. Set to 1 only for an approved paid run.
PODIFY_TTS_PAID_FALLBACK=0

# Option B: inference.sh Kokoro
# Uses same INFERENCE_API_KEY above

# Optional: OpenAI TTS (higher quality, higher cost)
# OPENAI_API_KEY=sk-...

# Lunary (for fetching grimoire content)
LUNARY_BASE_URL=https://lunary.app

# Vercel Blob Storage (optional — enables cloud serving on Vercel)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Auto-prune: max episodes kept in manifest (default: 60)
# MAX_EPISODES=60

# Output
OUTPUT_DIR=./output

# Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=your-password-here
AUTH_SECRET=random-64-char-hex-string
# Optional: API key for programmatic access (passed via x-api-key header)
# API_KEY=your-api-key-here

# Per-device quota (mobile app installs, issued via POST /api/auth/register-device)
# Free generations allowed per device per UTC calendar month. Default: 1.
# PODIFY_MONTHLY_DEVICE_QUOTA=1
